# Database (di VPS biasanya host "db" atau IP postgres, bukan localhost jika Docker network)
DATABASE_URL="postgresql://simplo:simplo@localhost:5432/simplo?schema=public"

# WAJIB diisi URL publik aplikasi (domain VPS / Nginx), BUKAN localhost
# Contoh: https://pms.domainanda.com  atau  http://IP_VPS:3000
NEXTAUTH_URL="https://your-domain.com"

NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Secret untuk cron auto-close laporan harian (Bearer token)
CRON_SECRET="change-me-cron-secret"

